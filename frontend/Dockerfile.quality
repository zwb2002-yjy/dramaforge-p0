FROM node:22-alpine

WORKDIR /workspace

RUN apk add --no-cache \
    ca-certificates \
    chromium \
    freetype \
    harfbuzz \
    nss \
    python3 \
    ttf-freefont \
    && ln -s /usr/bin/python3 /usr/local/bin/python

ENV DRAMAFORGE_E2E_EXECUTABLE_PATH=/usr/bin/chromium

COPY . .

RUN npm ci --prefix /workspace/frontend

CMD ["sh", "-c", "set -eu; npm run --prefix frontend api:check; npm run --prefix frontend format:check; npm run --prefix frontend lint; npm run --prefix frontend typecheck; npm run --prefix frontend test -- --run --maxWorkers=1 --minWorkers=1; npm run --prefix frontend build; npm run --prefix frontend test:e2e"]
