# DramaForge local environment template.
# Copy to `.env` and replace secrets before running outside throwaway local demos.
# Never commit real keys, BYOK material, or production passwords.

# Application
APP_ENV=development
APP_NAME=DramaForge
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (asyncpg DSN)
DATABASE_URL=postgresql+asyncpg://dramaforge:dramaforge@localhost:5432/dramaforge

# Redis / Arq
REDIS_URL=redis://localhost:6379/0
ARQ_DEFAULT_QUEUE_NAME=dramaforge:default
ARQ_HEAVY_QUEUE_NAME=dramaforge:heavy

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dramaforge
MINIO_REGION=us-east-1

# Session / CSRF (generate a long random string for non-dev environments)
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Fernet key for encrypting user BYOK at rest.
# Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
BYOK_FERNET_KEY=dev-only-fernet-key-replace-in-prod==

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
