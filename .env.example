# DramaForge local environment template.
# Copy to `.env` and replace secrets before running outside throwaway local demos.
# Never commit real keys, BYOK material, or production passwords.

# Application
APP_ENV=development
APP_NAME=DramaForge
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
PUBLIC_REGISTRATION_ENABLED=false
DRAMAFORGE_BIND_ADDRESS=127.0.0.1
DRAMAFORGE_PORT=8080
DRAMAFORGE_PUBLIC_ORIGIN=http://localhost:8080
# Optional prebuilt release images. Empty defaults to local Compose builds.
DRAMAFORGE_BACKEND_IMAGE=dramaforge-backend:local
DRAMAFORGE_FRONTEND_IMAGE=dramaforge-frontend:local

# PostgreSQL (asyncpg DSN)
POSTGRES_USER=dramaforge
POSTGRES_PASSWORD=
POSTGRES_DB=dramaforge
DATABASE_URL=

# Redis / Arq
REDIS_URL=redis://localhost:6379/0
ARQ_DEFAULT_QUEUE_NAME=dramaforge:default
ARQ_HEAVY_QUEUE_NAME=dramaforge:heavy

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=dramaforge
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=dramaforge
MINIO_SECRET_KEY=
MINIO_BUCKET=dramaforge
MINIO_REGION=us-east-1

# Required local secrets. Do not copy shared example values: run
# `python scripts/init_env.py` to create `.env` with unique values.
SESSION_SECRET=
WORKER_TOKEN=

# Fernet key for encrypting user BYOK at rest.
BYOK_FERNET_KEY=
BYOK_PRIMARY_KEY_VERSION=local-v1
BYOK_KEYRING=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Agnes AI hub (OpenAI-compatible). Put the real key only in local `.env` (gitignored).
# Image/video model names are hub-specific; freeze Adapter names remain flux/kling at the domain edge.
AGNES_ENABLED=false
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
REFERENCE_PUBLIC_BASE_URL=
REFERENCE_TOKEN_TTL_SECONDS=3600

# Optional outbound proxy for external model providers. Keep this empty unless
# the local network requires one; Docker Desktop can reach a host proxy through
# host.docker.internal (for example, http://host.docker.internal:7897).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,minio,litellm,litellm-db

# Limit parallel image/video/composite jobs when an upstream Provider or local
# development proxy cannot sustain the default concurrency.
ARQ_HEAVY_MAX_JOBS=4

# Text LLM BYOK (Anthropic Messages compatible). Never commit real keys.
TEXT_LLM_ENABLED=false
TEXT_LLM_API_KEY=
TEXT_LLM_BASE_URL=https://ai-models.app.baizhi.cloud/api/anthropic
# Hub catalog id for dsv4flash on baizhi is deepseek-v4-flash
TEXT_LLM_MODEL=deepseek-v4-flash
TEXT_LLM_API_STYLE=anthropic

# LiteLLM Proxy (fix spec §3/§24). The official Proxy is a separate runtime
# (docker-compose `litellm`); DramaForge calls it over HTTP and never installs
# the litellm SDK. Put the real key only in local `.env` (gitignored).
LITELLM_GATEWAY_URL=http://litellm:4000
# DramaForge client key for LiteLLM: a dedicated Virtual Key in production,
# not the Master Key (fix spec §57). Empty = gateway text models unavailable.
LITELLM_API_KEY=
# LiteLLM administrator key; do not expose to frontend (fix spec §23/§128-5).
# Generated uniquely by `python scripts/init_env.py`.
LITELLM_MASTER_KEY=
LITELLM_DB_PASSWORD=
# Pinned official image (fix spec §6/§128-7). Never use latest in production.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.96.0
# text.generate V3 router migration flag (spec §100-§101). Default OFF keeps the
# legacy OpenAI text path; flip to true after the gateway chain is verified.
TEXT_V3_ROUTER_ENABLED=false
# Static logical aliases registered as litellm/<alias> text models (comma-separated).
LITELLM_LOGICAL_MODELS=script-quality,script-fast
# Deployment env for the aliases in infra/litellm/config.yaml. Empty values are
# valid. For a local demo without provider keys set a *_MOCK_RESPONSE text.
LITELLM_SCRIPT_QUALITY_API_BASE=
LITELLM_SCRIPT_QUALITY_API_KEY=
LITELLM_SCRIPT_QUALITY_MOCK_RESPONSE=
LITELLM_SCRIPT_FAST_API_BASE=
LITELLM_SCRIPT_FAST_API_KEY=
LITELLM_SCRIPT_FAST_MOCK_RESPONSE=
LITELLM_LEGACY_TEXT_API_BASE=
LITELLM_LEGACY_TEXT_API_KEY=
LITELLM_LEGACY_TEXT_MOCK_RESPONSE=

# Local eSpeak NG voice. Keep false until the executable is available in the runtime.
TTS_ENABLED=false
TTS_ENGINE=espeak-ng
TTS_VOICE=zh

# Optional face embedding runtime. No pretrained weights are distributed or
# downloaded by DramaForge. Keep disabled unless licensed model files are
# mounted at INSIGHTFACE_MODEL_ROOT/models/INSIGHTFACE_MODEL_NAME.
INSIGHTFACE_ENABLED=false
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_MODEL_ROOT=/models/insightface
