# DramaForge local environment template.
# Copy to `.env` and replace secrets before running outside throwaway local demos.
# Never commit real keys, BYOK material, or production passwords.

# Application
APP_ENV=development
APP_NAME=DramaForge
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (asyncpg DSN)
DATABASE_URL=postgresql+asyncpg://dramaforge:dramaforge@localhost:5432/dramaforge

# Redis / Arq
REDIS_URL=redis://localhost:6379/0
ARQ_DEFAULT_QUEUE_NAME=dramaforge:default
ARQ_HEAVY_QUEUE_NAME=dramaforge:heavy

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dramaforge
MINIO_REGION=us-east-1

# Session / CSRF (generate a long random string for non-dev environments)
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Fernet key for encrypting user BYOK at rest.
# Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
BYOK_FERNET_KEY=dev-only-fernet-key-replace-in-prod==

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000

# Agnes AI hub (OpenAI-compatible). Put the real key only in local `.env` (gitignored).
# Image/video model names are hub-specific; freeze Adapter names remain flux/kling at the domain edge.
AGNES_ENABLED=false
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0

# Optional outbound proxy for external model providers. Keep this empty unless
# the local network requires one; Docker Desktop can reach a host proxy through
# host.docker.internal (for example, http://host.docker.internal:7897).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,minio

# Text LLM BYOK (Anthropic Messages compatible). Never commit real keys.
TEXT_LLM_ENABLED=false
TEXT_LLM_API_KEY=
TEXT_LLM_BASE_URL=https://ai-models.app.baizhi.cloud/api/anthropic
# Hub catalog id for dsv4flash on baizhi is deepseek-v4-flash
TEXT_LLM_MODEL=deepseek-v4-flash
TEXT_LLM_API_STYLE=anthropic

# Azure TTS / voice (P0 optional — leave false to skip paid TTS)
TTS_ENABLED=false
