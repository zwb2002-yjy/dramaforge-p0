FROM python:3.12-slim-bookworm

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_HTTP_TIMEOUT=180

RUN set -eux; \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
    apt_options="-o Acquire::Retries=10 -o Acquire::Queue-Mode=access -o Acquire::http::Pipeline-Depth=0 -o Acquire::http::Timeout=60"; \
    apt-get ${apt_options} update; \
    attempt=1; \
    while ! apt-get ${apt_options} install -y --no-install-recommends ffmpeg espeak-ng fonts-noto-cjk git; do \
        if [ "${attempt}" -ge 3 ]; then exit 1; fi; \
        attempt=$((attempt + 1)); \
        apt-get ${apt_options} update; \
    done; \
    rm -rf /var/lib/apt/lists/*; \
    pip install --no-cache-dir "uv==0.12.0"

COPY . .

RUN uv sync --locked --extra dev --directory /workspace/backend

CMD ["sh", "-c", "set -eu; python3 scripts/check_directory_compliance.py; python3 scripts/check_canonical_surface.py; uv run --directory backend ruff check app tests alembic/versions; uv run --directory backend mypy app; uv run --directory backend pytest tests/unit -q; uv run --directory backend alembic upgrade head; uv run --directory backend alembic check; uv run --directory backend pytest tests/integration --ignore=tests/integration/test_litellm_real_proxy.py -q -rs --fail-on-skip; mkdir -p /contract; PYTHONPATH=/workspace/backend uv run --directory backend python /workspace/scripts/_export_openapi.py --out /contract/openapi.json"]
